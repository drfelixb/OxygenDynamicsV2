  "Rules": [
    {
      "ID": "RB01",
      "Status": "proposed",
      "Text": "Retain preserved-input fixed native-union footprint and validated external clock; corrected trace remains primary for review.",
      "Adoption": null
    },
    {
      "ID": "RB02",
      "Status": "proposed",
      "Text": "Request round(20*fs) immediate pre-onset samples; require all to be observed, finite and free of either-sign native footprint overlap; no substitutions.",
      "Adoption": null
    },
    {
      "ID": "RB03",
      "Status": "proposed",
      "Text": "After adoption only, calculate each reviewed interval as a separate exploratory optical result; retain original automatic measurements and signed values.",
      "Adoption": null
    },
    {
      "ID": "RB04",
      "Status": "proposed",
      "Text": "Recommended option A retains native eligibility and flags shared reviewed interval/recovery contact. Alternative B adds an explicit inclusive-interval veto.",
      "Adoption": null
    },
    {
      "ID": "RB05",
      "Status": "proposed",
      "Text": "Keep recognition, numerical availability and claim-specific physiological assessment separate; do not demand a flat reference or force review of all events.",
      "Adoption": null
    }
  ],
